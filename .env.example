APP_ENV=local
APP_DEBUG=false
APP_SECURE_COOKIES=false
APP_CORS_ORIGINS=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=
DB_USER=
DB_PASS=

# SMTP (leave MAIL_HOST empty to skip email delivery)
# Gmail: port 587 + STARTTLS. PHPMailer negotiates STARTTLS automatically
# (SMTPAutoTLS; requires the PHP openssl extension), so no extra variable is needed.
# MAIL_PASS must be a 16-character Gmail App Password (Google Account > Security >
# 2-Step Verification > App passwords), NOT your normal Gmail password. Enter it without spaces.
# MAIL_FROM should be the same Gmail address (or a verified "Send mail as" alias).
# Do not put inline comments after values; the .env loader keeps them as part of the value.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your.address@gmail.com
MAIL_PASS=your16charapppassword
MAIL_FROM=your.address@gmail.com
